# Author: Joonyoung Ki
#
# Files excluded from the Docker build context: secrets, VCS data, caches, local build output and other
# files that the image does not need.

.git
.gitignore
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
htmlcov/
*.log
temp_uploads/

# Frontend (installed and built from scratch in the Docker build stage)
frontend/node_modules/
frontend/dist/
node_modules/
**/node_modules
**/dist

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Files not needed in the image
*.jpeg
*.png
docker-compose*.yml

# Author: Joonyoung Ki
# Purpose: Template of the environment variables read by the backend.
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database / AI / cache -------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/job_match
OPENAI_API_KEY=
REDIS_HOST=redis
REDIS_PORT=6379

# --- Accounts (login / wishlist) -------------------------------------------
# Required for /auth/* and /wishlist. At least 32 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Session lifetime in minutes (default 10080 = 7 days).
JWT_EXPIRE_MINUTES=10080
# Set to true once the site is served over HTTPS so the cookie gets the Secure flag.
# Keep false while serving plain HTTP, otherwise browsers will drop the cookie.
COOKIE_SECURE=false
# lax (default), strict or none (none forces Secure).
COOKIE_SAMESITE=lax
# Login rate limit: max failed attempts per IP / email within the window (seconds).
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=900
# Use the first X-Forwarded-For address as client IP. Enable only behind a trusted reverse proxy.
TRUST_FORWARDED_FOR=false

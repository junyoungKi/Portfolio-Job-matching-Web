# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# PostgreSQL (예: AWS RDS)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/job_match

# OpenAI
OPENAI_API_KEY=

# Redis (선택 사항 - 없으면 캐시 없이 동작)
# 로컬 직접 실행(python run.py): localhost (기본값)
# docker compose 실행: docker-compose.yml 이 redis://redis:6379/0 으로 자동 주입하므로 설정 불필요
REDIS_URL=redis://localhost:6379/0
# 비밀번호가 있는 경우: redis://:비밀번호@host:6379/0
# REDIS_URL 대신 REDIS_HOST / REDIS_PORT 로 지정할 수도 있습니다.

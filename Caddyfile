# Author: Joonyoung Ki
#
# Reverse proxy in front of the FastAPI app. TLS uses the Cloudflare Origin
# Certificate mounted from deploy/certs/ (not Let's Encrypt). Port 80 redirects
# to HTTPS. Caddy adds X-Forwarded-For, X-Forwarded-Proto, and X-Forwarded-Host.

{
	# The origin certificate is supplied as files. Do not start an ACME client.
	auto_https off
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	encode gzip zstd

	# "web" is the FastAPI service name on the compose network.
	reverse_proxy web:8000
}
